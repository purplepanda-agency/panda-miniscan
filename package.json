{
  "name": "jsonld-analyze",
  "version": "1.0.0",
  "description": "Site crawl for channels, meta signals, AI insights and a printable client verslag",
  "type": "module",
  "bin": {
    "jsonld-analyze": "./bin/jsonld-analyze.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "analyze": "node bin/jsonld-analyze.js",
    "build:notes": "esbuild src/frontend/tiptap-bundle.js --bundle --format=esm --outfile=public/vendor/tiptap.js --minify",
    "embed:prompts": "node scripts/embed-prompts.mjs",
    "predeploy": "npm run embed:prompts",
    "dev:cf": "npm run embed:prompts && wrangler dev",
    "deploy": "npm run embed:prompts && wrangler deploy",
    "cf:typegen": "wrangler types"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "json-ld",
    "schema.org",
    "seo",
    "structured-data"
  ],
  "license": "MIT",
  "dependencies": {
    "@tiptap/core": "2.26.1",
    "@tiptap/extension-placeholder": "2.26.1",
    "@tiptap/starter-kit": "2.26.1",
    "chalk": "^5.4.1",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.40.0"
  },
  "overrides": {
    "iconv-lite": "0.6.3"
  }
}
